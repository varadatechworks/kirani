NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kirani
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=kirani-api
# One-time tenant bootstrap inputs (only needed for npm run bootstrap:tenant)
BOOTSTRAP_TENANT_NAME=Kirani
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Kirani Admin

# Public origin used in customer-facing package QR labels (no trailing slash)
PUBLIC_APP_URL=https://kirani.example.com
# Razorpay test/live credentials; keep actual values in the deployment secret manager
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Inventory reservation expiry worker cadence (minimum 15 seconds)
KIRANI_MAINTENANCE_INTERVAL_MS=60000
